---
import MainLayout from '../layouts/main.astro';
import { baseUrl } from '../lib/base-url';

Astro.response.status = 410;
---

<MainLayout>
  <main class="unavailable-page">
    <section class="unavailable-card">
      <p class="unavailable-label">Miraka &amp; Co. Tools</p>
      <h1>Video Downloader unavailable</h1>
      <p>
        This experimental tool has been disabled because its download provider and supported formats were not reliable enough for production use.
      </p>
      <a href={`${baseUrl}/`}>Return to tools</a>
    </section>
  </main>
</MainLayout>

<style>
  .unavailable-page {
    min-height: 100vh;
    display: grid;
    place-items: center;
    padding: 24px;
    background: #f2f2f2;
  }

  .unavailable-card {
    width: min(100%, 620px);
    padding: 40px;
    border: 1px solid #e5e7eb;
    border-radius: 14px;
    background: #ffffff;
  }

  .unavailable-label {
    margin: 0 0 16px;
    color: #6b7280;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0 0 16px;
    color: #1a1a1a;
    font-size: clamp(32px, 6vw, 56px);
    line-height: 0.98;
    letter-spacing: -0.04em;
  }

  p {
    color: #4b5563;
    line-height: 1.6;
  }

  a {
    display: inline-flex;
    margin-top: 20px;
    padding: 12px 18px;
    border-radius: 10px;
    background: #1a1a1a;
    color: #ffffff;
    text-decoration: none;
    font-weight: 600;
  }
</style>
