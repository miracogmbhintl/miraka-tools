---
import HTMLPreviewTool from '../components/HTMLPreviewTool';
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <link rel="icon" type="image/png" href="/favicon.ico" />
  <meta name="viewport" content="width=device-width" />
  <meta name="referrer" content="no-referrer" />
  <title>HTML Preview Tool - Miraka Tools</title>
  <style>
    body {
      margin: 0;
      padding: 0;
      overflow: hidden;
    }

    @media (max-width: 768px) {
      body {
        overflow: auto;
      }
    }
  </style>
  <script is:inline>
    (() => {
      const originalWrite = Document.prototype.write;
      const previewPolicy = [
        "default-src 'none'",
        "script-src 'none'",
        "connect-src 'none'",
        "object-src 'none'",
        "frame-src 'none'",
        "form-action 'none'",
        "base-uri 'none'",
        "img-src data: blob: https: http:",
        "media-src data: blob: https: http:",
        "font-src data: https: http:",
        "style-src 'unsafe-inline' https: http:",
      ].join('; ');

      Document.prototype.write = function (...chunks) {
        const frame = this.defaultView?.frameElement;
        if (!(frame instanceof HTMLIFrameElement) || frame.title !== 'HTML Preview') {
          return originalWrite.apply(this, chunks);
        }

        const policyTag = `<meta http-equiv="Content-Security-Policy" content="${previewPolicy}">`;
        const html = chunks.join('');
        const securedHtml = /<head(?:\s[^>]*)?>/i.test(html)
          ? html.replace(/<head(\s[^>]*)?>/i, (match) => `${match}${policyTag}`)
          : `${policyTag}${html}`;

        return originalWrite.call(this, securedHtml);
      };

      const securePreview = (root = document) => {
        root.querySelectorAll?.('iframe[title="HTML Preview"]').forEach((iframe) => {
          if (iframe.getAttribute('sandbox') !== 'allow-same-origin') {
            iframe.setAttribute('sandbox', 'allow-same-origin');
            iframe.setAttribute('referrerpolicy', 'no-referrer');
          }
        });
      };

      const observer = new MutationObserver((mutations) => {
        for (const mutation of mutations) {
          for (const node of mutation.addedNodes) {
            if (node instanceof Element) securePreview(node);
          }
        }
      });

      observer.observe(document.documentElement, { childList: true, subtree: true });
      securePreview();
      document.addEventListener('DOMContentLoaded', () => securePreview(), { once: true });
    })();
  </script>
</head>
<body>
  <HTMLPreviewTool client:only="react" />
</body>
</html>
